# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env (ele já está no .gitignore).

# Chave da API-Football (crie uma conta grátis em https://www.api-football.com/)
API_FOOTBALL_KEY=

# Banco de dados
DATABASE_URL=postgresql+asyncpg://futebol:futebol@db:5432/futebol_stats
DATABASE_SSL=false

# Provedor de odds (fase 2 — deixe em branco por enquanto)
ODDS_API_KEY=

# Token pra proteger as rotas /admin/sync-today e /admin/seed (necessárias
# porque planos grátis de hospedagem não dão acesso a terminal). Escolha
# qualquer texto secreto.
ADMIN_TOKEN=
